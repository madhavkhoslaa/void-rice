#!/bin/sh
exec 2>&1
. /etc/sv/wpa_supplicant/conf
install -d -m 0770 -o root -g ricewifi /run/wpa_supplicant
# Global control only on Ethernet-only VMs; no fictitious wlan0 interface.
if [ "$WPA_INTERFACE" = none ]; then
    exec /usr/bin/wpa_supplicant -g /run/wpa_supplicant/global
fi
[ -d "/sys/class/net/$WPA_INTERFACE" ] || { sleep 2; exit 1; }
# No -B: the supervised process must stay in the foreground.
exec /usr/bin/wpa_supplicant -D nl80211 -i "$WPA_INTERFACE" -c "$CONF_FILE"
